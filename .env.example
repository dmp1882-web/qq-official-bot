# 配置示例：把需要的项写进环境变量，或者在本目录放同名 key 文件（二选一即可）。
# 切勿把真实密钥提交到任何公开仓库。

# QQ 开放平台机器人的 AppID 与 AppSecret（https://q.qq.com 申请）
QQ_APPID=
QQ_APP_SECRET=

# DeepSeek API Key（AI 聊天 / 搜一下 / 摇一摇点评都用它）
# 也可以把 key 写进本目录的 deepseek_key.txt
DEEPSEEK_KEY_FILE=

# 网易云音乐 Cookie 文件路径（默认本目录 netease_cookie.txt）
NETEASE_COOKIE_FILE=

# 百度搜索 API Key 文件（默认本目录 baidu_key.txt）
BAIDU_KEY_FILE=

# 点歌语音旧 URL 回退方式需要的公网主机名/IP（file_data 直传失败时才用）
PUBLIC_HOST=

# 查服目标：Minecraft 基岩版服务器地址与端口（默认 19132）
MC_SERVER_HOST=
MC_SERVER_PORT=19132

# 点赞功能依赖 NapCat 的 OneBot HTTP API；未配置则点赞不可用
NAPCAT_API=http://127.0.0.1:3000
NAPCAT_TOKEN=

# 查玩家（Xbox）需要自建中转服务，未配置则该功能不可用（见 README）
XBL_RELAY_URL=
XBL_RELAY_SECRET_FILE=
